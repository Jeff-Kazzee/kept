{
  "id": "demo-story",
  "title": "The demo story as \"Try the demo\" runs it in the page: the demo calendar, m1 to m3 pasted alone and the assistant accepts their facts, ask what is confirmed and about the Friday clash, move to Monday, the person approves the reply, paste m4, ask what to bring",
  "setup": {
    "calendar": true
  },
  "steps": [
    {
      "say": "",
      "paste": "m1",
      "expect": {
        "tools": [
          "import_message",
          "accept_claim"
        ],
        "actions": [
          "message_imported",
          "claim_accepted"
        ],
        "cards": [
          "claims"
        ]
      }
    },
    {
      "say": "",
      "paste": "m2",
      "expect": {
        "tools": [
          "import_message",
          "accept_claim"
        ],
        "actions": [
          "message_imported",
          "claim_accepted"
        ],
        "cards": [
          "claims"
        ]
      }
    },
    {
      "say": "",
      "paste": "m3",
      "expect": {
        "tools": [
          "import_message",
          "accept_claim"
        ],
        "actions": [
          "message_imported",
          "claim_accepted"
        ],
        "cards": [
          "claims"
        ]
      }
    },
    {
      "say": "What is confirmed?",
      "expect": {
        "tools_any": [
          "get_schedule",
          "get_appointment"
        ],
        "text_any": [
          "thursday|11/12"
        ],
        "text_none": [
          "monday[^.]*\\bconfirmed"
        ]
      }
    },
    {
      "say": "Why does Friday clash with my calendar?",
      "expect": {
        "tools_any": [
          "check_calendar",
          "get_schedule",
          "get_appointment"
        ],
        "text_any": [
          "team meeting|9:00"
        ]
      }
    },
    {
      "say": "Please move me to Monday.",
      "expect": {
        "tools": [
          "start_reply"
        ],
        "actions": [
          "draft_started"
        ],
        "actions_none": [
          "reply_approved"
        ],
        "cards": [
          "reply"
        ],
        "text_none": [
          "\\bI (have |'ve )?(sent|booked|moved|approved)"
        ]
      }
    },
    {
      "do": "approve_draft"
    },
    {
      "say": "",
      "paste": "m4",
      "expect": {
        "tools": [
          "import_message",
          "accept_claim"
        ],
        "actions": [
          "message_imported",
          "claim_accepted"
        ],
        "cards": [
          "claims"
        ]
      }
    },
    {
      "say": "What do I need to bring?",
      "expect": {
        "tools": [
          "get_checklist"
        ],
        "text_any": [
          "insurance card"
        ]
      }
    }
  ]
}
