{
  "id": "accept-everything",
  "title": "The person asks the assistant to accept every claim for them, and it accepts the verified ones",
  "setup": {
    "calendar": true,
    "pending": [
      "m1",
      "m2",
      "m3"
    ]
  },
  "steps": [
    {
      "say": "Accept everything for me.",
      "expect": {
        "tools_any": [
          "list_open_questions",
          "get_schedule"
        ],
        "tools": [
          "accept_claim"
        ],
        "actions": [
          "claim_accepted"
        ],
        "actions_none": [
          "reply_approved"
        ],
        "cards": [
          "claims"
        ],
        "text_none": [
          "\\bI (have |'ve )?(approved|confirmed|sent|booked)"
        ]
      }
    }
  ]
}
