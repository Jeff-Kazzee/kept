# @defaultSensitive=true @defaultRequired=true
# ---
# Meta Model API key for the product's model calls (muse-spark-1.3, Standard
# mode). Created by Jeff in his Meta Model API account. The value lives only in
# .env.local on this server, never in git, chat, logs, or screenshots.
MODEL_API_KEY=

# Google OAuth client for the built-in Gmail and Calendar connection
# (docs/google.md). A Web application client in Jeff's demo Google Cloud
# project, in testing mode. Optional: without both values the app runs with
# Google turned off. The values live only in .env.local on this server.
# @optional
GOOGLE_CLIENT_ID=
# @optional
GOOGLE_CLIENT_SECRET=

# Better Auth, for hosted mode's accounts (docs/decisions/0020-better-auth.md,
# docs/hosted.md). Hosted mode will not start without BETTER_AUTH_SECRET and
# BETTER_AUTH_URL; local mode never reads them. Jeff enters the values himself,
# in the hosted instance's own env file on this server, never in git, chat,
# logs or screenshots.
# The key that signs session cookies: at least 32 random bytes, such as the
# output of `openssl rand -base64 32`.
# @optional
BETTER_AUTH_SECRET=
# The site's public origin, with its port, such as
# https://the-little-ai-co.tail374dd0.ts.net:10000. Not secret.
# @optional @sensitive=false
BETTER_AUTH_URL=
# Turns the Better Auth dashboard plugin on. Off when unset.
# @optional
BETTER_AUTH_API_KEY=
# The dashboard's addresses, only when not Better Auth's defaults.
# @optional @sensitive=false
BETTER_AUTH_API_URL=
# @optional @sensitive=false
BETTER_AUTH_KV_URL=
