# @defaultSensitive=true @defaultRequired=true
# ---
# Meta Model API key for the product's model calls (muse-spark-1.3, Standard
# mode). Created by Jeff in his Meta Model API account. The value lives only in
# .env.local on this server, never in git, chat, logs, or screenshots.
MODEL_API_KEY=

# Google OAuth client for the built-in Gmail and Calendar connection
# (docs/google.md). A Web application client in Jeff's demo Google Cloud
# project, in testing mode. Optional: without both values the app runs with
# Google turned off. The values live only in .env.local on this server.
# @optional
GOOGLE_CLIENT_ID=
# @optional
GOOGLE_CLIENT_SECRET=
